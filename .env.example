# Outscraper
OUTSCRAPER_API=replace-with-your-outscraper-api-key

# Amazon S3
S3_BUCKET_NAME=replace-with-your-bucket-name
AWS_DEFAULT_REGION=eu-central-1
# Required if boto3 cannot use an existing AWS credential source.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
# Set this when using temporary AWS credentials.
# AWS_SESSION_TOKEN=replace-with-your-aws-session-token

# Snowflake
SNOWFLAKE_ACCOUNT=replace-with-your-account-identifier
SNOWFLAKE_USER=replace-with-your-username
SNOWFLAKE_PASSWORD=replace-with-your-password
SNOWFLAKE_WAREHOUSE=replace-with-your-warehouse
SNOWFLAKE_DATABASE=GOOGLE_SEARCH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=replace-with-your-role

# Local Airflow UI account
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-this-local-password
